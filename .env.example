# ───────────────────────────────────────────────────────────────
# Ajustes globales de la API Trazabilidad (NO commitear .env).
# Las conexiones por planta van en plantas.config.json
# (copiar de plantas.config.example.json).
# ───────────────────────────────────────────────────────────────

PORT=3000

# Ruta al archivo de plantas (conexiones PostgreSQL + SQL Server por planta).
PLANTAS_CONFIG=plantas.config.json

# ─── Espejo SQL Server ("LOCAL") ───
# Desactivado por defecto: en Android la app Delphi nunca abre MSSQL ({$IFNDEF ANDROID}).
MIRROR_ENABLED=false
# strict  = si falla el espejo, la operacion falla. lenient = continua con PostgreSQL.
MIRROR_WRITE_MODE=strict

# ─── Liberacion en Control Final (etiquetas_maestro_* en PostgreSQL) ───
LIBERACION_COCINA_ENABLED=true
LIBERACION_TERMO_ENABLED=false
